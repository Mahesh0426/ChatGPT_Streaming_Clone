# ──────────────────────────────────────────────────────────────────────────────
#  Stage 1 – deps
#  Install all dependencies and generate the Prisma client.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

# Copy package manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# postinstall runs `prisma generate`, which needs the schema and config
COPY prisma.config.ts ./
COPY prisma ./prisma

# Install all deps (postinstall runs prisma generate)
# DATABASE_URL is not needed at install time – prisma generate does not connect
RUN pnpm install --frozen-lockfile

# Record the locked Prisma CLI version so the migration tool uses the same version.
RUN node -p "require('./node_modules/prisma/package.json').version" > /app/.prisma-version


# ──────────────────────────────────────────────────────────────────────────────
#  Stage 2 – prisma-cli
#  Install only the Prisma CLI needed by the one-off migration container.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS prisma-cli
WORKDIR /migrate

RUN apk add --no-cache openssl
COPY --from=deps /app/.prisma-version /tmp/.prisma-version

RUN npm init -y > /dev/null && \
    npm install --omit=dev --no-audit --no-fund \
      prisma@$(cat /tmp/.prisma-version) dotenv && \
    npm cache clean --force

COPY prisma.config.ts ./
COPY prisma ./prisma


# ──────────────────────────────────────────────────────────────────────────────
#  Stage 3 – builder
#  Build the Next.js app (output: "standalone").
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

# Copy installed node_modules and generated Prisma client from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/lib/generated ./lib/generated

# Copy the rest of the source
COPY . .

# Build args for public (NEXT_PUBLIC_*) env vars baked into the bundle.
# Pass these via --build-arg when running docker build.
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
ARG NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
ARG NEXT_PUBLIC_DEMO_EMAIL=
ARG NEXT_PUBLIC_DEMO_PASSWORD=

ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_SIGN_IN_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_URL
ENV NEXT_PUBLIC_CLERK_SIGN_UP_URL=$NEXT_PUBLIC_CLERK_SIGN_UP_URL
ENV NEXT_PUBLIC_DEMO_EMAIL=$NEXT_PUBLIC_DEMO_EMAIL
ENV NEXT_PUBLIC_DEMO_PASSWORD=$NEXT_PUBLIC_DEMO_PASSWORD

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm build


# ──────────────────────────────────────────────────────────────────────────────
#  Stage 4 – runner
#  One production image for both the app and one-off migration container.
# ──────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Resolve IPv4 addresses first: the container has no IPv6 route, so connecting
# to IPv6 addresses (e.g. Neon's) hangs until the connection times out.
# --no-network-family-autoselection stops Node from racing IPv6 and IPv4, which
# still waited on the IPv6 addresses even with ipv4first set
ENV NODE_OPTIONS="--dns-result-order=ipv4first --no-network-family-autoselection"

# Create a non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Copy standalone output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Copy static assets (CSS, JS chunks, etc.)
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copy public folder
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Include the isolated Prisma CLI for the migration service.
COPY --from=prisma-cli --chown=nextjs:nodejs /migrate /migrate

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js is the minimal Next.js server generated by standalone output
CMD ["node", "server.js"]
